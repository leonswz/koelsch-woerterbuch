generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Word {
  id                 Int           @id @default(autoincrement())
  koelsch            String        @unique
  slug               String        @unique
  phonetic           String?
  translation        String
  example            String?
  exampleTranslation String?
  category           String        @default("allgemein")
  aliases            String[]      @default([])
  partOfSpeech       String?
  notes              String?
  reviewStatus       String        @default("pending")
  source             String?
  sourceUrl          String?
  sourceLicense      String?
  uncertain          Boolean       @default(false)
  sources            Json?
  importedAt         DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  meanings           WordMeaning[]
  variants           WordVariant[]

  @@index([reviewStatus])
}

model WordMeaning {
  id                 Int      @id @default(autoincrement())
  wordId             Int
  position           Int
  translation        String
  definition         String?
  partOfSpeech       String?
  register           String?
  example            String?
  exampleTranslation String?
  reviewStatus       String   @default("pending")
  source             String?
  sourceUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  word               Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, position])
  @@index([translation])
}

model WordVariant {
  id           Int      @id @default(autoincrement())
  wordId       Int
  position     Int
  spelling     String
  label        String?
  region       String?
  reviewStatus String   @default("pending")
  source       String?
  sourceUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  word         Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, spelling])
  @@index([spelling])
}

model Song {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  artist      String
  lyrics      String?
  translation String?
  notes       String?
  youtubeUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Proverb {
  id          Int      @id @default(autoincrement())
  koelsch     String   @unique
  translation String
  explanation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
